digraph "WHO SMART Trust — metamodel in use" {
  graph [rankdir=TB, newrank=true, fontname="Helvetica", fontsize=11, nodesep=0.6, ranksep=1.3];
  node [shape=box, style="filled", fontname="Helvetica", fontsize=11, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", fontcolor="#333333"];
  subgraph cluster_0 {
    label="Business"; class="mm-layer-business"; labeljust=l; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb"; fontcolor="#666666";
    rank=same;
    "BusinessProcess" [label="Business Process
3 element(s)", class="mm-layer-business", fillcolor="#ffffb5", URL="../../en/smart-trust/archimate/1.7.5/metamodel/#type-BusinessProcess", target="_top", tooltip="Business Process: its elements"];
  }
  subgraph cluster_1 {
    label="Application"; class="mm-layer-application"; labeljust=l; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb"; fontcolor="#666666";
    rank=same;
    "ApplicationComponent" [label="Application Component
5 element(s)
(to itself: flows to ×7, composed of ×1)", class="mm-layer-application", fillcolor="#b5ffff", URL="../../en/smart-trust/archimate/1.7.5/metamodel/#type-ApplicationComponent", target="_top", tooltip="Application Component: its elements"];
    "DataObject" [label="Data Object
3 element(s)", class="mm-layer-application", fillcolor="#b5ffff", URL="../../en/smart-trust/archimate/1.7.5/metamodel/#type-DataObject", target="_top", tooltip="Data Object: its elements"];
  }
  "BusinessProcess" -> "ApplicationComponent" [style=invis, constraint=true, weight=10];
  "ApplicationComponent" -> "DataObject" [label="accesses ×5", class="mm-cat-dependency mm-from-application mm-to-application", style=dotted, arrowhead=vee, arrowsize=0.6, URL="../../en/smart-trust/archimate/1.7.5/metamodel/#pattern-ApplicationComponent-DataObject", target="_top", tooltip="Application Component → Data Object: its relationships"];
  "ApplicationComponent" -> "BusinessProcess" [label="✗ assigned to ×2", class="mm-cat-structural mm-from-application mm-to-business", dir=both, arrowtail=dot, arrowhead=normal, color="#c0392b", fontcolor="#c0392b", penwidth=2, URL="../../en/smart-trust/archimate/1.7.5/metamodel/#pattern-ApplicationComponent-BusinessProcess", target="_top", tooltip="Application Component → Business Process: its relationships"];
  "BusinessProcess" -> "DataObject" [label="accesses ×2", class="mm-cat-dependency mm-from-business mm-to-application", style=dotted, arrowhead=vee, arrowsize=0.6, URL="../../en/smart-trust/archimate/1.7.5/metamodel/#pattern-BusinessProcess-DataObject", target="_top", tooltip="Business Process → Data Object: its relationships"];
}
