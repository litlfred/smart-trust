// Arabic (ar) CodeSystem supplements for this IG's own CodeSystems.
// Agent translation, UNOFFICIAL and unreviewed: no human sign-off. One file per locale;
// the CodeSystems themselves are not edited. Displays and definitions mirror translations/ar/.

CodeSystem: DomainsAr
Id: Domains-ar
Title: "نطاقات الثقة في GDHCN التابعة لمنظمة الصحة العالمية (WHO)"
Description: "ملحق باللغة العربية (ar) لنظام الرموز Domains: تسميات كل مفهوم. ترجمة غير رسمية أعدّها وكيل آلي، دون مراجعة بشرية."
* ^status = #draft
* ^experimental = true
* ^content = #supplement
* ^supplements = Canonical(Domains)
* ^language = #ar
* ^caseSensitive = true
* #DDCC "DDCC" "يُعرِّف دليلُ التنفيذ SMART التوثيقَ الرقمي لشهادات COVID-19 (DDCC) على العنوان http://smart.who.int/ddcc"
  * ^designation[0].language = #ar
  * ^designation[0].value = "DDCC"
* #IPS-PILGRIMAGE "IPS للحج" "يُعرِّف دليلُ التنفيذ SMART ملخصَ المريض الدولي (IPS) للحج على العنوان http://smart.who.int/ips-pilgrimage"
  * ^designation[0].language = #ar
  * ^designation[0].value = "IPS للحج"
* #PH4H "الطريق السريع للبلدان الأمريكية للصحة الرقمية (PH4H)" "يُعرِّف دليلُ التنفيذ SMART الطريقَ السريع للبلدان الأمريكية للصحة الرقمية (PH4H) على العنوان https://worldhealthorganization.github.io/smart-ph4h/"
  * ^designation[0].language = #ar
  * ^designation[0].value = "الطريق السريع للبلدان الأمريكية للصحة الرقمية (PH4H)"
* #ICVP "الشهادة الدولية للتطعيم أو الاتقاء (ICVP)" "يُعرِّف دليلُ التنفيذ SMART الشهادةَ الدولية للتطعيم أو الاتقاء (ICVP) على العنوان https://worldhealthorganization.github.io/smart-icvp/"
  * ^designation[0].language = #ar
  * ^designation[0].value = "الشهادة الدولية للتطعيم أو الاتقاء (ICVP)"

