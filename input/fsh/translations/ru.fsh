* ^content = #supplement
* ^supplements = Canonical(KeyUsage-UAT)
* ^language = #ru
* #SCA "Signer Certificate Authority (SCA)"
* #SCA ^designation[+].language = #ru
* #SCA ^designation[=].value = "Удостоверяющий центр подписантов (SCA)"
* #DSC "Document Signing Certificate (DSC)"
* #DSC ^designation[+].language = #ru
* #DSC ^designation[=].value = "Сертификат подписанта документов (DSC)"
