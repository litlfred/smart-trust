* #DECA ^designation[+].language = #ru
* #DECA ^designation[=].value = "Удостоверяющий центр обмена данными (DECA)"
* #DESC "Data Exchange Signing Certificate (DESC)"
* #DESC ^designation[+].language = #ru
* #DESC ^designation[=].value = "Сертификат подписи для обмена данными (DESC)"
* #TLS "Transport Layer Security (TLS)"
* #TLS ^designation[+].language = #ru
* #TLS ^designation[=].value = "Протокол безопасности транспортного уровня (TLS)"
* #UP "Upload (UP)"
* #UP ^designation[+].language = #ru
* #UP ^designation[=].value = "Загрузка (UP)"

