// Simplified Chinese (zh) display designations for this IG's code systems,
// as FHIR CodeSystem supplements (content = supplement): FHIR's own
// translation mechanism, one file per locale, no edit to the base code systems.
// UNOFFICIAL: drafted by an agent; no human has signed it off.
// Codes, acronyms and identifiers are kept as written.

CodeSystem: KeyUsageZh
Id: KeyUsage-zh
Title: "WHO GDHCN Key Usage CodeSystem — Chinese (zh) supplement"
Description: "Unofficial Simplified Chinese (zh) display designations for the KeyUsage code system, drafted by an agent and not signed off by a human."
* ^experimental = true
* ^status = #draft
* ^language = #zh
* ^content = #supplement
* ^supplements = Canonical(KeyUsage)
* #SCA
* #SCA ^designation[+].language = #zh
* #SCA ^designation[=].value = "签名者证书颁发机构（SCA）"
* #DSC
* #DSC ^designation[+].language = #zh
* #DSC ^designation[=].value = "文档签名证书（DSC）"
* #DECA
* #DECA ^designation[+].language = #zh
* #DECA ^designation[=].value = "数据交换证书颁发机构（DECA）"
* #DESC
* #DESC ^designation[+].language = #zh
* #DESC ^designation[=].value = "数据交换签名证书（DESC）"
* #TLS
* #TLS ^designation[+].language = #zh
* #TLS ^designation[=].value = "传输层安全（TLS）"
* #UP
* #UP ^designation[+].language = #zh
* #UP ^designation[=].value = "上传（UP）"

