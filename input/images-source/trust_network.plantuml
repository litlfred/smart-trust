@startuml
' Trust Network: computable source for the former hand-drawn trust_network.png.
' Step 1: a participant's Certificate Authority submits its public key to the
'         Trust Anchor, which certifies provenance and onboards the member.
' Step 2: the Trust Anchor distributes the verified public keys to all members.
' Step 3: any member verifies the provenance of credentialed documents from any
'         other member, using the keys from step 2.
!include ./style.iuml
!include <material/common>
!include <material/key>
!include <material/file_document>

title Trust Network
left to right direction

rectangle "1. Onboard" as S1 {
  agent "Country A's\nCertificate Authority" as CA_A
  agent "[[system-actors.html#trust-network-anchor Trust Anchor]]" as TA1
  CA_A --> TA1 : public key A
  note right of TA1 : certifies provenance;\nonboards members
}

rectangle "2. Distribute" as S2 {
  agent "[[system-actors.html#trust-network-anchor Trust Anchor]]" as TA2
  package "verified public keys" as KEYS {
    MA_KEY(Black,1,kA,rectangle,"A")
    MA_KEY(Black,1,kB,rectangle,"B")
    MA_KEY(Black,1,kC,rectangle,"C")
  }
  agent "[[system-actors.html#trust-network-participant Country A]]" as P2A
  agent "[[system-actors.html#trust-network-participant Country B]]" as P2B
  agent "[[system-actors.html#trust-network-participant Country C]]" as P2C
  TA2 --> KEYS
  KEYS --> P2A
  KEYS --> P2B
  KEYS --> P2C
}

rectangle "3. Verify (GDHCN Trust Network)" as S3 {
  agent "[[system-actors.html#trust-network-participant Country A]]\nkeys A, B, C" as P3A
  agent "[[system-actors.html#trust-network-participant Country B]]\nkeys A, B, C" as P3B
  agent "[[system-actors.html#trust-network-participant Country C]]\nkeys A, B, C" as P3C
  P3A <--> P3B : signed document
  P3B <--> P3C : signed document
  P3C <--> P3A : signed document
  note bottom of P3C : credentialed document provenance\nfrom any member can be verified\nby any other member
}

S1 -[hidden]-> S2
S2 -[hidden]-> S3
@enduml
